#deptype sys

# @system
! {
	bash
	^awk$
	gmake
	GNU make
	g\+\+ GNU compiler
	chmod
        ^gcc
        ^g\+\+
        ^C\+\+11
        C\+\+11.*compiler
}

# always provided? (except for Gentoo/*BSD)
! {
	Linux.*operating.*system
}
# always provided
! {
	POSIX.*OS
	Unix
}

# rpcgen is part of glibc
! :: rpcgen
